formation_hint = "ПОГРЕБАЛЬНЫЙ ОБРЯД — носильщики прикрывают жреца. Прервите ритуал, пока он не завершён."
alternate_formation_hint = "КОСОЙ КАТАФАЛК — носильщики идут уступом, а жрец держится в тылу."
