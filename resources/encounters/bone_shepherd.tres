enemy_names = PackedStringArray("Костяной пастух", "Костяной агнец", "Костяной агнец")
enemy_positions = PackedVector2Array(1035, 262, 840, 173, 848, 355)
alternate_enemy_positions = PackedVector2Array(1090, 270, 852, 223, 929, 337)
formation_hint = "РАЗДЕЛЁННОЕ СТАДО — агнцы с разных сторон, Пастух держится позади."
alternate_formation_hint = "СБЛИЖЁННОЕ СТАДО — агнцы наступают рядом, Пастух глубже в тылу."
