script = ExtResource("1")
encounter_id = "bone_shepherd"
title = "КОСТЯНОЙ ПАСТУХ"
card_text = "На тропу выходит Пастух с двумя костяными агнцами. Его свист заставляет стадо одновременно бросаться в атаку. Убейте пастуха, чтобы он больше не отдавал приказов."
wizard_line = "Такие послушные овцы. Жаль, что тебя они не считают пастухом."
arena_id = "graveyard"
