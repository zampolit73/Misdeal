[gd_resource type="Resource" script_class="EncounterData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/encounter_data.gd" id="1_encounter"]

[resource]
script = ExtResource("1_encounter")
encounter_id = "iron_wall"
title = "ЖЕЛЕЗНАЯ СТЕНА"
card_text = "Два склепных часовых держат проход. Позади уже слышны шаги другой группы.\nПосле первого натиска уцелевшим дадут мгновение перестроиться."
wizard_line = "Стена хороша тем, что за ней всегда кто-то прячется."
arena_id = "iron_wall"
enemy_unit_paths = PackedStringArray("res://resources/units/crypt_sentinel.tres", "res://resources/units/crypt_sentinel.tres")
enemy_names = PackedStringArray("Склепный часовой", "Склепный часовой")
enemy_positions = PackedVector2Array(875, 175, 875, 335)
formation_hint = "ВОЛНА I — часовые закрывают проход. Держите линию."
alternate_enemy_positions = PackedVector2Array(850, 155, 945, 345)
alternate_formation_hint = "ВОЛНА I — часовые идут по диагонали."
second_wave_unit_paths = PackedStringArray("res://resources/units/bone_archer.tres", "res://resources/units/skeleton.tres")
second_wave_names = PackedStringArray("Костяной лучник", "Проклятый пехотинец")
second_wave_positions = PackedVector2Array(1015, 150, 835, 360)
second_wave_hint = "СТРЕЛОК — СВЕРХУ\nПЕХОТА — СНИЗУ"
wave_one_status = "ВОЛНА I / II — часовые перекрывают проход. После первой атаки будет передышка."
wave_intermission_status = "ПЕРЕДЫШКА — герои сохранили здоровье. Новая атака с фланга."
wave_two_status = "ВОЛНА II — стрелы с верхнего фланга, пехота снизу."
wave_intermission_wizard_line = "Они ещё не кончились. Поправь своих бойцов, пока я тасую остальных."
wave_two_wizard_line = "Вторую стену я строю не из камня. Из вас."
